{
  "name": "car-deals-mcp",
  "version": "1.0.0",
  "description": "An MCP server that searches for car deals from Cars.com, Autotrader, and KBB",
  "main": "src/server.js",
  "bin": {
    "car-deals-mcp": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "node scripts/smoke.js",
    "audit": "npm audit --audit-level=high"
  },
  "keywords": [
    "mcp",
    "car-deals",
    "scraper",
    "cars.com",
    "autotrader",
    "kbb"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "puppeteer": "^25.10.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src/",
    "scripts/",
    "assets/",
    "mcp.json",
    "server.json",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ]
}
